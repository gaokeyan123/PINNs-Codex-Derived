# ── Model weights — GITIGNORED to prevent repo bloat ─────────────────────────
# Naming convention: pinns_v{MAJOR}.{MINOR}_ep{EPOCH:05d}_loss{VAL:.4e}.pth
# Example:          pinns_v1.0_ep05000_loss1.2345e-04.pth
# Keep only the best checkpoint per version; log it in checkpoints/BEST_MODELS.md
2DPhaseChangePINNs/checkpoints/*.pth

# ── Large outputs (figures / numpy dumps) ─────────────────────────────────────
2DPhaseChangePINNs/outputs/*.npy
2DPhaseChangePINNs/outputs/*.npz
2DPhaseChangePINNs/outputs/*.png
2DPhaseChangePINNs/outputs/*.pdf

